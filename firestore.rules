rules_version = '2';

// Cada persona solo puede leer y escribir sus propios datos.
// Pegar en: Consola de Firebase > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Ranking público: cualquiera lo lee (solo nombre de perfil, avatar y puntos).
    // Cada quien escribe solo sus perfiles ({uid}_{perfil}), con campos y valores acotados.
    // Lo equipado (marco, título, fondo, efecto, hasta 3 insignias) tiene que estar canjeado por la cuenta.
    function owns(id) {
      return id == null || exists(/databases/$(database)/documents/storePurchases/$(request.auth.uid + '_' + id));
    }
    function validLook(l) {
      return l.keys().hasOnly(['frame', 'title', 'background', 'effect', 'badges'])
        && owns(l.get('frame', null)) && owns(l.get('title', null))
        && owns(l.get('background', null)) && owns(l.get('effect', null))
        && l.get('badges', []) is list && l.get('badges', []).size() <= 3
        && (l.get('badges', []).size() < 1 || owns(l.badges[0]))
        && (l.get('badges', []).size() < 2 || owns(l.badges[1]))
        && (l.get('badges', []).size() < 3 || owns(l.badges[2]));
    }

    match /leaderboard/{entry} {
      allow read: if true;
      allow delete: if request.auth != null && entry.matches(request.auth.uid + '_[A-Za-z0-9]+');
      allow create, update: if request.auth != null
        && entry.matches(request.auth.uid + '_[A-Za-z0-9]+')
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'score', 'updatedAt', 'look'])
        && (!('look' in request.resource.data) || validLook(request.resource.data.look))
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 80
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 10000000
        && request.resource.data.updatedAt == request.time
        // Una sola escritura no puede subir más de 2000 puntos (frena trampas obvias).
        && (resource == null || request.resource.data.score <= resource.data.score + 2000);
    }

    // Tienda: stock compartido. Solo se descuenta de a 1, y solo junto con la compra de quien canjea
    // (en la misma transacción). Nadie lo crea ni lo repone desde el app.
    match /storeStock/{item} {
      allow read: if true;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['left'])
        && resource.data.left > 0
        && request.resource.data.left == resource.data.left - 1
        && !exists(/databases/$(database)/documents/storePurchases/$(request.auth.uid + '_' + item))
        && existsAfter(/databases/$(database)/documents/storePurchases/$(request.auth.uid + '_' + item));
    }

    // Compras: una por persona y artículo ({uid}_{artículo}); no se editan ni se borran.
    match /storePurchases/{id} {
      allow read: if request.auth != null && id.matches(request.auth.uid + '_.+');
      allow create: if request.auth != null
        && id == request.auth.uid + '_' + request.resource.data.item
        && request.resource.data.keys().hasOnly(['item', 'price', 'profile', 'at'])
        && request.resource.data.price is int && request.resource.data.price > 0
        && request.resource.data.at == request.time
        // el stock baja en la misma transacción
        && getAfter(/databases/$(database)/documents/storeStock/$(request.resource.data.item)).data.left
           == get(/databases/$(database)/documents/storeStock/$(request.resource.data.item)).data.left - 1;
    }

    // Sorteo del Boleto Dorado: un boleto por persona por semana; cualquiera ve cuántos hay.
    match /storeRaffle/{week}/entries/{uid} {
      allow read: if true;
      allow create: if request.auth != null && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.at == request.time;
    }
  }
}
